# Telegram bot
HERDR_TG_TOKEN=your-bot-token-here
HERDR_TG_CHAT_ID=your-chat-id

# Relay address (for clients connecting to this relay)
HERDR_RELAY=ws://127.0.0.1:8375

# Remote herdr instances via SSH (comma-separated)
HERDR_REMOTES=user@server1,user@server2

# --- ntfy notifications (opt-in) -------------------------------------------
# Entirely optional and off by default; Web Push stays the default channel. Setting a topic is the
# only thing required to turn it on. Unlike Web Push, ntfy needs no VAPID keys, no service worker and
# no HTTPS on the relay, so it works when the relay is only reachable over plain http.
# Pick a long, unguessable topic: on a public server the topic name is the only access control.
#HERDR_NTFY_TOPIC=herdr-a8f3c1b90d2e

# Self-hosted server (default: https://ntfy.sh)
#HERDR_NTFY_SERVER=https://ntfy.example.com

# Auth — either an access token, or username + password. Both optional.
#HERDR_NTFY_TOKEN=tk_xxxxxxxxxxxxxxxx
#HERDR_NTFY_USER=herdr
#HERDR_NTFY_PASSWORD=secret

# Presentation. Priority: min|low|default|high|urgent (default: high).
# Tags are ntfy emoji shortcodes, comma-separated (default: sheep).
#HERDR_NTFY_PRIORITY=high
#HERDR_NTFY_TAGS=sheep,warning
#HERDR_NTFY_TITLE_PREFIX=[herdr]

# Base URL of the web app, to make notifications tappable (opens the blocked pane).
#HERDR_NTFY_CLICK_BASE=http://127.0.0.1:8375

# Also notify when an agent unblocks. Off by default — ntfy cannot replace a delivered
# notification, so this doubles the message count.
#HERDR_NTFY_NOTIFY_RESOLVED=1
#HERDR_NTFY_RESOLVED_PRIORITY=low

# Seconds to wait on the ntfy server before giving up (default: 5).
#HERDR_NTFY_TIMEOUT=5
